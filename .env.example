# Meta Model API key for the SkillForge pipeline (forge/client.py).
#
# forge/client.py reads the key from ~/skilldrive/.env (NOT from this repo).
# Copy this file there and fill in your key:
#
#   cp .env.example ~/skilldrive/.env
#   # then edit ~/skilldrive/.env and set the value below
#
# Accepted variable names (first match wins):
#   MODEL_API_KEY, META_API_KEY, META_AI_API_KEY, MUSE_API_KEY, OPENAI_API_KEY
#
# NEVER commit a real key. This example file must always stay empty.
MODEL_API_KEY=
