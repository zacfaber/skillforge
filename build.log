/Users/zacfaber/festus-feasts-definitive/site/index.html:13:<section class="hero wrap" id="top" aria-labelledby="hero-title"><svg class="route route-hero" viewBox="0 0 1200 680" aria-hidden="true"><path d="M-40 566C146 562 214 518 308 526s162 77 278 51c118-26 136-126 267-135 91-6 135 28 217 1 79-26 109-91 191-101"/><circle cx="308" cy="526" r="10"/><circle cx="853" cy="442" r="10"/></svg><div class="hero-copy"><p class="kicker">Festus Ezeli</p><h1 id="hero-title">Champion.<br>Broadcaster.<br><em>Founder.</em></h1><p class="hero-deck">Building a media platform around food, people and the Bay.</p><div class="hero-actions"><a class="button primary" href="#spots">Explore Festus Feasts <span aria-hidden="true">↓</span></a><a class="button quiet" href="{{dest:contact}}" data-event="business_contact_click">Work with Festus <span aria-hidden="true">↗</span></a></div></div><figure class="hero-portrait">{{photo:portrait}}<figcaption>Festus Ezeli at 9JaGrills, Oakland. <span>Carolyn Fong / The San Francisco Standard</span></figcaption></figure></section>
